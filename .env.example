# Database
DATABASE_URL=

# Auth.js
# AUTH_SECRET: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Optional: issuer of a single-tenant Azure app registration. Unset falls back
# to https://login.microsoftonline.com/common/v2.0 (any Microsoft account).
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
# Comma-separated addresses allowed to sign in. Empty means nobody can.
AUTH_ALLOWED_EMAILS=

# Anthropic
ANTHROPIC_API_KEY=

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# App-layer encryption for OAuth tokens (context.md §7)
# 32 bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
