# Database
DATABASE_URL=

# Auth.js
# AUTH_SECRET: openssl rand -base64 32
AUTH_SECRET=
# Public base URL of the dashboard. Render terminates TLS at a proxy, so the
# Gmail OAuth redirect URI is built from this rather than from the request.
# Origin only, no path: Auth.js takes any path here as its own base path.
AUTH_URL=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Optional but recommended: issuer of a single-tenant Azure app registration.
# Unset falls back to https://login.microsoftonline.com/common/v2.0, which
# accepts every Microsoft directory — and any directory can put an arbitrary
# address in the `email` claim the allowlist below matches on.
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
# Comma-separated addresses allowed to sign in. Empty means nobody can.
AUTH_ALLOWED_EMAILS=

# Anthropic
ANTHROPIC_API_KEY=

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# App-layer encryption for OAuth tokens (context.md §7)
# 32 bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
